@model IEnumerable<PetAdoptionSystem.Models.Pet>

<h1 class="mb-4">可領養寵物</h1>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">

            <div class="col-md-3">
                <label class="form-label">動物種類</label>
                <select name="category" class="form-select">
                    <option value="">全部</option>
                    <option value="犬">犬</option>
                    <option value="貓">貓</option>
                    <option value="其他">其他</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">年齡</label>
                <select name="ageRange" class="form-select">
                    <option value="">全部</option>
                    <option value="under1">1歲以下</option>
                    <option value="1to5">1到5歲</option>
                    <option value="over5">5歲以上</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">性別</label>
                <select name="gender" class="form-select">
                    <option value="">全部</option>
                    <option value="0">公</option>
                    <option value="1">母</option>
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    查詢
                </button>
            </div>

        </form>
    </div>
</div>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(item.Photo))
                {
                    <img src="~/images/@item.Photo"
                         class="card-img-top"
                         style="height:250px; object-fit:cover;" />
                }

                <div class="card-body">

                    <h4 class="card-title">
                        @item.PetName
                    </h4>

                    <p class="card-text">
                        <strong>種類：</strong>@item.Category<br />
                        <strong>性別：</strong>@(item.Gender == 0 ? "公" : "母")<br />
                        <strong>年齡：</strong>@item.Age 歲<br />
                        <strong>體型：</strong>@item.Size
                    </p>

                    <a asp-action="Details"
                       asp-route-id="@item.PId"
                       class="btn btn-outline-primary">
                        查看詳細資料
                    </a>

                </div>
            </div>
        </div>
    }

</div>