@{
    ViewData["Title"] = "Login";
}

<h2>會員登入</h2>

@if (ViewBag.Error != null)
{
    <p style="color:red">
        @ViewBag.Error
    </p>
}

<form asp-action="Login" method="post">

    <div>
        <label>Email</label>
        <input type="text"
               name="uMail"
               class="form-control" />
    </div>

    <br />

    <div>
        <label>密碼</label>
        <input type="password"
               name="Password"
               class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        登入
    </button>

</form>

<br />

<a asp-action="Register">沒有帳號？前往註冊</a>