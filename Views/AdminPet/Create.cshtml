@model PetAdoptionSystem.Models.Pet

<h1 class="text-center mb-4">新增寵物</h1>

<div class="form-card">

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div class="mb-3">

            <label class="form-label">
                寵物照片
            </label>

            <input type="file"
                   name="photoFile"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                寵物名字
            </label>

            <input asp-for="PetName"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                種類
            </label>

            <select asp-for="Category"
                    class="form-select">

                <option value="犬">犬</option>
                <option value="貓">貓</option>
                <option value="其他">其他</option>

            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                性別
            </label>

            <select asp-for="Gender"
                    class="form-select">

                <option value="0">公</option>
                <option value="1">母</option>

            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                年齡
            </label>

            <input asp-for="Age"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                體型
            </label>

            <input asp-for="Size"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                健康紀錄
            </label>

            <textarea asp-for="HealthRecord"
                      class="form-control"
                      rows="4"></textarea>

        </div>

        <div class="mb-3">

            <label class="form-label">
                收容所來源
            </label>

            <select asp-for="SId"
                    asp-items="ViewBag.ShelterList"
                    class="form-select">
            </select>

        </div>

        <div class="text-center">

            <button type="submit"
                    class="btn btn-add">
                新增寵物
            </button>

        </div>

    </form>

    <hr />

    <div class="text-center">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            返回寵物管理
        </a>

    </div>

</div>
