@model PetAdoptionSystem.Models.Pet

<h1 class="text-center mb-4">修改寵物資料</h1>

<div class="form-card">

    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" asp-for="PId" />
        <input type="hidden" asp-for="Photo" />

        <div class="text-center mb-4">

            <label class="form-label d-block">
                目前照片
            </label>

            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="~/images/@Model.Photo"
                     style="width:180px; height:180px; object-fit:cover; border-radius:15px;" />
            }
            else
            {
                <p class="text-muted">目前沒有照片</p>
            }

        </div>

        <div class="mb-3">

            <label class="form-label">
                更換照片
            </label>

            <input type="file"
                   name="photoFile"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                寵物名字
            </label>

            <input asp-for="PetName"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                種類
            </label>

            <select asp-for="Category"
                    class="form-select">
                <option value="犬">犬</option>
                <option value="貓">貓</option>
                <option value="其他">其他</option>
            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                性別
            </label>

            <select asp-for="Gender"
                    class="form-select">
                <option value="0">公</option>
                <option value="1">母</option>
            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                年齡
            </label>

            <input asp-for="Age"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                體型
            </label>

            <input asp-for="Size"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                健康紀錄
            </label>

            <textarea asp-for="HealthRecord"
                      class="form-control"
                      rows="4"></textarea>

        </div>

        <div class="mb-3">

            <label class="form-label">
                目前狀態
            </label>

            <select asp-for="pStatus"
                    class="form-select">
                <option value="0">待領養</option>
                <option value="1">申請中</option>
                <option value="2">已領養</option>
            </select>

        </div>

        <div class="mb-3">

            <label class="form-label">
                收容所來源
            </label>

            <select asp-for="SId"
                    asp-items="ViewBag.ShelterList"
                    class="form-select">
            </select>

        </div>

        <div class="text-center">

            <button type="submit"
                    class="btn btn-edit">
                儲存修改
            </button>

        </div>

    </form>

    <hr />

    <div class="text-center">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            返回寵物管理
        </a>

    </div>

</div>