@model IEnumerable<PetAdoptionSystem.Models.Pet>

<h1 class="mb-4">寵物管理</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        新增寵物
    </a>
</p>
<form asp-action="Index" method="get" class="mb-4">

    <div class="row">

        <div class="col-md-4">

            <select name="status" class="form-select">

                <option value="">全部狀態</option>

                @if (ViewBag.Status == 0)
                {
                    <option value="0" selected>待領養</option>
                }
                else
                {
                    <option value="0">待領養</option>
                }

                @if (ViewBag.Status == 1)
                {
                    <option value="1" selected>申請中</option>
                }
                else
                {
                    <option value="1">申請中</option>
                }

                @if (ViewBag.Status == 2)
                {
                    <option value="2" selected>已領養</option>
                }
                else
                {
                    <option value="2">已領養</option>
                }

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary w-100">
                篩選
            </button>

        </div>

    </div>

</form>
<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>照片</th>
            <th>名字</th>
            <th>種類</th>
            <th>性別</th>
            <th>年齡</th>
            <th>體型</th>
            <th>健康紀錄</th>
            <th>狀態</th>
            <th>操作</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.Photo))
                    {
                        <img src="~/images/@item.Photo"
                             style="width:100px; height:100px; object-fit:cover;"
                             class="rounded" />
                    }
                </td>

                <td>@item.PetName</td>
                <td>@item.Category</td>
                <td>@(item.Gender == 0 ? "公" : "母")</td>
                <td>@item.Age 歲</td>
                <td>@item.Size</td>
                <td>@item.HealthRecord</td>

                <td>
                    @if (item.pStatus == 0)
                    {
                        <span class="badge bg-success">待領養</span>
                    }
                    else if (item.pStatus == 1)
                    {
                        <span class="badge bg-warning text-dark">申請中</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">已領養</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.PId"
                       class="btn btn-sm btn-outline-primary">
                        修改
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.PId"
                       class="btn btn-sm btn-outline-danger">
                        刪除
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>