@model PetAdoptionSystem.Models.Shelter

<h1 class="text-center mb-4">修改收容所</h1>

<div class="form-card">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="SId" />

        <div class="mb-3">

            <label class="form-label">
                機構名稱
            </label>

            <input asp-for="OrgName"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                地址
            </label>

            <input asp-for="Location"
                   class="form-control" />

        </div>

        <div class="text-center">

            <button type="submit"
                    class="btn btn-edit">
                儲存修改
            </button>

        </div>

    </form>

    <hr />

    <div class="text-center">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            返回收容所列表
        </a>

    </div>

</div>
