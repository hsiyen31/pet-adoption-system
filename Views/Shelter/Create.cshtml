@model PetAdoptionSystem.Models.Shelter

<h1 class="text-center mb-4">新增收容所</h1>

<div class="form-card">

    <form asp-action="Create" method="post">

        <div class="mb-3">

            <label class="form-label">
                機構名稱
            </label>

            <input asp-for="OrgName"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                地址
            </label>

            <input asp-for="Location"
                   class="form-control" />

        </div>

        <div class="text-center">

            <button type="submit"
                    class="btn btn-add">
                新增
            </button>

        </div>

    </form>

</div>